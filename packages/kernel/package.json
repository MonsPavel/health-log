{
  "name": "@hl/kernel",
  "version": "0.0.0",
  "private": true,
  "description": "Instant, Result, AppError, константы (порог «мало данных»). Не зависит ни от чего (docs/architecture/03-modules.md §4).",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/index.ts','dist/index.js')\""
  }
}
