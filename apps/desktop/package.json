{
  "name": "@hl/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Electron-приложение: main-процесс, preload-мост `hl` (наполнение — TASK-008), рендерер React 18 + Vite. Рендерер импортирует только @hl/contracts через preload-мост.",
  "type": "module",
  "main": "dist/main/app/bootstrap.js",
  "scripts": {
    "dev": "pnpm --filter @hl/kernel --filter @hl/contracts run build && concurrently -k -n vite,electron -c cyan,green \"vite\" \"wait-on tcp:127.0.0.1:5183 && tsc -b tsconfig.main.json && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5183 electron .\"",
    "build": "tsc -b tsconfig.main.json && pnpm build:renderer",
    "build:renderer": "vite build",
    "prepare-native": "bash scripts/prepare-native.sh",
    "postinstall": "bash scripts/prepare-native.sh"
  },
  "dependencies": {
    "@hl/contracts": "workspace:*",
    "@hl/kernel": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "i18next": "^26.4.2",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0",
    "zod": "^4.6.5"
  }
}
